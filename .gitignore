# ---------------------------------------------------------------------------
# Secrets and credentials, never commit these.
# The app itself stores its GitHub token in the OS keychain, or (when no
# keychain is available) in a 0600 file in the user's *config* directory, not
# in the project. These patterns are belt-and-braces.
# ---------------------------------------------------------------------------
*.secret
token.secret
*.pem
*.key
*.p12
*.pfx
*.keystore
.env
.env.*
!.env.example
secrets.*
credentials.*
*_token*
*.token
.netrc
.npmrc

# ---------------------------------------------------------------------------
# Local app state (if the app is ever run from inside the checkout)
# ---------------------------------------------------------------------------
config.json
activity.log
pre-restore/
icons/check.svg
icons/chevron*.svg

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib60/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
.python-version

