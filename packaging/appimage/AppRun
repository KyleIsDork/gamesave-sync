#!/bin/sh
# AppImage entry point. Resolves the bundle root, then execs the PyInstaller
# binary with the bundled Qt libraries taking precedence.
HERE="$(dirname "$(readlink -f "${0}")")"

export LD_LIBRARY_PATH="${HERE}/usr/lib:${LD_LIBRARY_PATH}"
export QT_PLUGIN_PATH="${HERE}/usr/lib/PySide6/Qt/plugins:${QT_PLUGIN_PATH}"

# Wayland sessions occasionally lack the Qt Wayland plugin; fall back to XCB
# rather than failing to start with no message.
if [ -z "${QT_QPA_PLATFORM}" ] && [ -n "${WAYLAND_DISPLAY}" ]; then
    if [ ! -e "${HERE}/usr/lib/PySide6/Qt/plugins/platforms/libqwayland-generic.so" ]; then
        export QT_QPA_PLATFORM=xcb
    fi
fi

exec "${HERE}/usr/bin/gamesave-sync" "$@"
